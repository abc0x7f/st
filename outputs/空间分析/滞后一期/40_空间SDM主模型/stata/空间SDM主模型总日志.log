. 
. * ------------------------------
. * 1. Mata 辅助函数
. * ------------------------------
. mata:
------------------------------------------------- mata (type end to exit) -----
: real matrix row_normalize(real matrix W)
> {
>     real scalar i, s
>     real matrix R
> 
>     R = W
>     for (i = 1; i <= rows(R); i++) {
>         s = sum(R[i,])
>         if (s != 0) {
>             R[i,] = R[i,] :/ s
>         }
>     }
>     return(R)
> }

: end
-------------------------------------------------------------------------------

. 
. * ------------------------------
. * 2. 读取空间矩阵
. * ------------------------------
. capture program drop build_w_matrix

. program define build_w_matrix, rclass
  1.     syntax , WFILE(string) WNAME(name)
  2. 
.     preserve
  3.         import delimited using "`wfile'", clear varnames(1) encoding(utf8)
>  stringcols(1)
  4.         drop province
  5.         unab wvars : _all
  6.         mkmat `wvars', matrix(`wname'_raw)
  7.     restore
  8. 
.     mata: st_matrix("`wname'", row_normalize(st_matrix("`wname'_raw")))
  9.     matrix drop `wname'_raw
 10.     return local wname "`wname'"
 11. end

. 
. * ------------------------------
. * 3. 主面板数据
. * ------------------------------
. tempfile panel_raw

. import delimited using "${DATA_FILE}", clear varnames(1) encoding(utf8)
(10 vars, 240 obs)

. keep province year eff lntl ind urb rd open es

. drop if missing(province, year, eff, lntl, ind, urb, rd, open, es)
(0 observations deleted)

. replace province = trim(province)
(0 real changes made)

. destring year eff lntl ind urb rd open es, replace force
year already numeric; no replace
eff already numeric; no replace
lntl already numeric; no replace
ind already numeric; no replace
urb already numeric; no replace
rd already numeric; no replace
open already numeric; no replace
es already numeric; no replace

. sort province year

. save "`panel_raw'", replace
(file C:\Users\abc0x7f\AppData\Local\Temp\ST_6198_000001.tmp not found)
file C:\Users\abc0x7f\AppData\Local\Temp\ST_6198_000001.tmp saved as .dta
    format

. global TMP_PANEL_RAW "`panel_raw'"

. 
. * ------------------------------
. * 4. 结果收集表
. * ------------------------------
. tempfile coef_results effect_results

. postfile coef_handle str32 weight_type str20 section str20 variable ///
>     double coef double se double zstat double pvalue double ll double ul ///
>     using "`coef_results'", replace
(file C:\Users\abc0x7f\AppData\Local\Temp\ST_6198_000002.tmp not found)

. postfile effect_handle str32 weight_type str20 effect_type str20 variable ///
>     double coef double se double zstat double pvalue double ll double ul ///
>     using "`effect_results'", replace
(file C:\Users\abc0x7f\AppData\Local\Temp\ST_6198_000003.tmp not found)

. 
. * ------------------------------
. * 5. 单个矩阵的模型估计
. * ------------------------------
. capture program drop run_sdm_model

. program define run_sdm_model
  1.     syntax , TAG(string) LABEL(string) WFILE(string)
  2. 
.     tempname W RTAB
  3.     local k = 0
  4. 
.     quietly build_w_matrix, wfile("`wfile'") wname(`W')
  5.     local WNAME "`r(wname)'"
  6. 
.     use "${TMP_PANEL_RAW}", clear
  7.     encode province, gen(pid)
  8.     xtset pid year
  9. 
.     capture log close sdm_`tag'
 10.     log using "${STATA_DIR}/SDM主模型_`tag'.log", text replace name(sdm_`t
> ag')
 11. 
.     display as text "============================================"
 12.     display as text "矩阵：`label' (`tag')"
 13.     display as text "双固定效应 SDM 主模型"
 14.     display as text "============================================"
 15. 
.     quietly xsmle eff lntl ind urb rd open es, ///
>         wmat(`WNAME') model(sdm) fe type(both) effect nolog
 16. 
.     ereturn display
 17.     return list
 18.     matrix `RTAB' = r(table)
 19. 
.     local cnames : colfullnames e(b)
 20.     local k = colsof(`RTAB')
 21. 
.     forvalues j = 1/`k' {
 22.         local token : word `j' of `cnames'
 23.         local clean = subinstr("`token'", ":", " ", .)
 24.         local section : word 1 of `clean'
 25.         local variable : word 2 of `clean'
 26. 
.         scalar b  = `RTAB'[1,`j']
 27.         scalar se = `RTAB'[2,`j']
 28.         scalar zz = `RTAB'[3,`j']
 29.         scalar pp = `RTAB'[4,`j']
 30.         scalar ll = `RTAB'[5,`j']
 31.         scalar ul = `RTAB'[6,`j']
 32. 
.         if inlist("`section'", "Main", "Wx", "Spatial", "Variance") {
 33.             post coef_handle ("`tag'") ("`section'") ("`variable'") ///
>                 (b) (se) (zz) (pp) (ll) (ul)
 34.         }
 35.         else if inlist("`section'", "LR_Direct", "LR_Indirect", "LR_Total"
> ) {
 36.             post effect_handle ("`tag'") ("`section'") ("`variable'") ///
>                 (b) (se) (zz) (pp) (ll) (ul)
 37.         }
 38.     }
 39. 
.     log close sdm_`tag'
 40. end

. 
