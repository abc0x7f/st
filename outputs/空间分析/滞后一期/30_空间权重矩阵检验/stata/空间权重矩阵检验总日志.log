. * ------------------------------
. * 6. 单个矩阵的完整检验流程
. * ------------------------------
. capture program drop run_one_matrix

. program define run_one_matrix
  1.     syntax , TAG(string) LABEL(string) WFILE(string)
  2. 
.     tempname W WLM
  3.     tempfile province_order wdiag_dta
  4.     local df_time = ${T_PERIOD} - 1
  5.     local df_ind  = ${N_CROSS} - 1
  6. 
.     preserve
  7.         import delimited using "`wfile'", clear varnames(1) encoding(utf8)
>  stringcols(1)
  8.         gen order_id = _n
  9.         keep province order_id
 10.         save "`province_order'", replace
 11.     restore
 12. 
.     quietly build_w_matrix, wfile("`wfile'") wname(`W')
 13.     local WNAME "`r(wname)'"
 14. 
.     use "${TMP_PANEL_RAW}", clear
 15.     merge m:1 province using "`province_order'"
 16.     count if _merge != 3
 17.     if r(N) {
 18.         display as error "面板省份与空间权重矩阵省份无法完全匹配。"
 19.         list province year _merge if _merge != 3 in 1/20
 20.         exit 459
 21.     }
 22.     drop _merge
 23.     sort order_id year
 24. 
.     gen pid = order_id
 25.     xtset pid year
 26. 
.     preserve
 27.         clear
 28.         mata: st_matrix("`WLM'", panel_blockdiag(st_matrix("`WNAME'"), ${T
> _PERIOD}))
 29.         svmat `WLM', names(col)
 30.         save "`wdiag_dta'", replace
 31.     restore
 32. 
.     capture spatwmat drop `WLM'
 33.     quietly spatwmat using "`wdiag_dta'", name(`WLM') standardize
 34. 
.     * ----------------------------------------
.     * A. LM / Robust LM
.     * ----------------------------------------
.     capture log close lm_`tag'
 35.     log using "${STATA_DIR}/LM_`tag'.log", text replace name(lm_`tag')
 36. 
.     display as text "============================================"
 37.     display as text "矩阵：`label' (`tag')"
 38.     display as text "LM / Robust LM 检验"
 39.     display as text "============================================"
 40. 
.     quietly tabulate pid, generate(pid_d_)
 41.     quietly tabulate year, generate(year_d_)
 42. 
.     regress eff lntl ind urb rd open es pid_d_2-pid_d_${N_CROSS} year_d_2-yea
> r_d_${T_PERIOD}
 43. 
.     noisily spatdiag, weights(`WLM')
 44.     return list
 45. 
.     capture confirm matrix r(stats)
 46.     if !_rc {
 47.         matrix list r(stats)
 48.     }
 49. 
.     capture confirm matrix r(stats)
 50.     if !_rc {
 51.         tempname LMSTAT
 52.         matrix `LMSTAT' = r(stats)
 53.         post lm_handle ("`tag'") ("LM Error") (`LMSTAT'[2,1]) (`LMSTAT'[2,
> 2]) (`LMSTAT'[2,3])
 54.         post lm_handle ("`tag'") ("Robust LM Error") (`LMSTAT'[3,1]) (`LMS
> TAT'[3,2]) (`LMSTAT'[3,3])
 55.         post lm_handle ("`tag'") ("LM Lag") (`LMSTAT'[4,1]) (`LMSTAT'[4,2]
> ) (`LMSTAT'[4,3])
 56.         post lm_handle ("`tag'") ("Robust LM Lag") (`LMSTAT'[5,1]) (`LMSTA
> T'[5,2]) (`LMSTAT'[5,3])
 57.     }
 58. 
.     log close lm_`tag'
 59. 
.     * ----------------------------------------
.     * B. LR：个体 / 时间 / 双固定 SDM
.     * ----------------------------------------
.     capture log close sdm_`tag'
 60.     log using "${STATA_DIR}/模型结果_`tag'.log", text replace name(sdm_`ta
> g')
 61. 
.     display as text "============================================"
 62.     display as text "矩阵：`label' (`tag')"
 63.     display as text "SDM 个体 / 时间 / 双固定估计"
 64.     display as text "============================================"
 65. 
.     quietly xsmle eff lntl ind urb rd open es, ///
>         wmat(`WNAME') model(sdm) fe type(ind) nolog noeffects
 66.     estimates store ind_`tag'
 67.     estimates restore ind_`tag'
 68.     ereturn display
 69. 
.     quietly xsmle eff lntl ind urb rd open es, ///
>         wmat(`WNAME') model(sdm) fe type(time) nolog noeffects
 70.     estimates store time_`tag'
 71.     estimates restore time_`tag'
 72.     ereturn display
 73. 
.     quietly xsmle eff lntl ind urb rd open es, ///
>         wmat(`WNAME') model(sdm) fe type(both) nolog noeffects
 74.     estimates store both_`tag'
 75.     estimates restore both_`tag'
 76.     ereturn display
 77. 
.     display as text "--------------------------------------------"
 78.     display as text "LR 检验"
 79.     display as text "--------------------------------------------"
 80. 
.     quietly lrtest both_`tag' ind_`tag', df(`df_time')
 81.     post lr_handle ("`tag'") ("LR: both vs ind") (r(chi2)) (`df_time') (r(
> p))
 82.     noisily lrtest both_`tag' ind_`tag', df(`df_time')
 83. 
.     quietly lrtest both_`tag' time_`tag', df(`df_ind')
 84.     post lr_handle ("`tag'") ("LR: both vs time") (r(chi2)) (`df_ind') (r(
> p))
 85.     noisily lrtest both_`tag' time_`tag', df(`df_ind')
 86. 
.     * ----------------------------------------
.     * C. Wald：SDM -> SAR / SDM -> SEM
.     * ----------------------------------------
.     display as text "--------------------------------------------"
 87.     display as text "Wald 检验"
 88.     display as text "--------------------------------------------"
 89. 
.     quietly estimates restore both_`tag'
 90. 
.     quietly test ///
>         ([Wx]lntl = 0) ///
>         ([Wx]ind  = 0) ///
>         ([Wx]urb  = 0) ///
>         ([Wx]rd   = 0) ///
>         ([Wx]open = 0) ///
>         ([Wx]es   = 0)
 91.     post wald_handle ("`tag'") ("Wald: SDM -> SAR") (r(chi2)) (r(df)) (r(p
> ))
 92.     noisily test ///
>         ([Wx]lntl = 0) ///
>         ([Wx]ind  = 0) ///
>         ([Wx]urb  = 0) ///
>         ([Wx]rd   = 0) ///
>         ([Wx]open = 0) ///
>         ([Wx]es   = 0)
 93. 
.     quietly testnl ///
>         ([Wx]lntl = -[Spatial]rho*[Main]lntl) ///
>         ([Wx]ind  = -[Spatial]rho*[Main]ind) ///
>         ([Wx]urb  = -[Spatial]rho*[Main]urb) ///
>         ([Wx]rd   = -[Spatial]rho*[Main]rd) ///
>         ([Wx]open = -[Spatial]rho*[Main]open) ///
>         ([Wx]es   = -[Spatial]rho*[Main]es)
 94.     post wald_handle ("`tag'") ("Wald: SDM -> SEM") (r(chi2)) (r(df)) (r(p
> ))
 95.     noisily testnl ///
>         ([Wx]lntl = -[Spatial]rho*[Main]lntl) ///
>         ([Wx]ind  = -[Spatial]rho*[Main]ind) ///
>         ([Wx]urb  = -[Spatial]rho*[Main]urb) ///
>         ([Wx]rd   = -[Spatial]rho*[Main]rd) ///
>         ([Wx]open = -[Spatial]rho*[Main]open) ///
>         ([Wx]es   = -[Spatial]rho*[Main]es)
 96. 
.     log close sdm_`tag'
 97. end

. 
