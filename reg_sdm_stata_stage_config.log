. * ------------------------------
. * 5. 单个矩阵的模型估计
. * ------------------------------
. capture program drop run_sdm_model

. program define run_sdm_model
  1.     syntax , TAG(string) LABEL(string) WFILE(string)
  2. 
.     tempname W RTAB
  3.     tempfile province_order
  4.     local k = 0
  5. 
.     preserve
  6.         import delimited using "`wfile'", clear varnames(1) encoding(utf8)
>  stringcols(1)
  7.         gen order_id = _n
  8.         keep province order_id
  9.         save "`province_order'", replace
 10.     restore
 11. 
.     quietly build_w_matrix, wfile("`wfile'") wname(`W')
 12.     local WNAME "`r(wname)'"
 13. 
.     use "${TMP_PANEL_RAW}", clear
 14.     merge m:1 province using "`province_order'"
 15.     count if _merge != 3
 16.     if r(N) {
 17.         display as error "面板省份与空间权重矩阵省份无法完全匹配。"
 18.         list province year _merge if _merge != 3 in 1/20
 19.         exit 459
 20.     }
 21.     drop _merge
 22.     sort order_id year
 23.     gen pid = order_id
 24.     xtset pid year
 25. 
.     capture log close sdm_`tag'
 26.     log using "${STATA_DIR}/SDM主模型_`tag'.log", text replace name(sdm_`t
> ag')
 27. 
.     display as text "============================================"
 28.     display as text "矩阵：`label' (`tag')"
 29.     display as text "双固定效应 SDM 主模型"
 30.     display as text "============================================"
 31. 
.     * -- FE model WITHOUT effects (for Hausman, matches RE parameter set) --
.     quietly xsmle eff lntl ind urb rd open es, ///
>         wmat(`WNAME') model(sdm) fe type(both) nolog noeffects
 32.     estimates store fe_`tag'
 33. 
.     * -- FE model WITH effects (for coefficient extraction) --
.     quietly xsmle eff lntl ind urb rd open es, ///
>         wmat(`WNAME') model(sdm) fe type(both) effect nolog
 34.     matrix `RTAB' = r(table)
 35. 
.     local cnames : colfullnames e(b)
 36.     local k = colsof(`RTAB')
 37. 
.     forvalues j = 1/`k' {
 38.         local token : word `j' of `cnames'
 39.         local clean = subinstr("`token'", ":", " ", .)
 40.         local section : word 1 of `clean'
 41.         local variable : word 2 of `clean'
 42. 
.         scalar b  = `RTAB'[1,`j']
 43.         scalar se = `RTAB'[2,`j']
 44.         scalar zz = `RTAB'[3,`j']
 45.         scalar pp = `RTAB'[4,`j']
 46.         scalar ll = `RTAB'[5,`j']
 47.         scalar ul = `RTAB'[6,`j']
 48. 
.         if inlist("`section'", "Main", "Wx", "Spatial", "Variance") {
 49.             post coef_handle ("`tag'") ("`section'") ("`variable'") ///
>                 (b) (se) (zz) (pp) (ll) (ul)
 50.         }
 51.         else if inlist("`section'", "LR_Direct", "LR_Indirect", "LR_Total"
> ) {
 52.             post effect_handle ("`tag'") ("`section'") ("`variable'") ///
>                 (b) (se) (zz) (pp) (ll) (ul)
 53.         }
 54.     }
 55. 
.     * -- RE model for spatial Hausman test (after coefficient extraction) --
.     capture noisily xsmle eff lntl ind urb rd open es, ///
>         wmat(`WNAME') model(sdm) re nolog noeffects
 56.     if _rc == 0 {
 57.         estimates store re_`tag'
 58. 
.         display as text "--------------------------------------------"
 59.         display as text "空间 Hausman 检验：FE (both) vs RE"
 60.         display as text "--------------------------------------------"
 61. 
.         capture hausman fe_`tag' re_`tag'
 62.         if _rc == 0 {
 63.             post hausman_handle ("`tag'") ("Hausman: FE vs RE (spatial)") 
> ///
>                 (r(chi2)) (r(df)) (r(p))
 64.             noisily hausman fe_`tag' re_`tag'
 65.         }
 66.         else {
 67.             * Try with sigmamore option (common fix for non-positive-defin
> ite VCE difference)
.             capture hausman fe_`tag' re_`tag', sigmamore
 68.             if _rc == 0 {
 69.                 post hausman_handle ("`tag'") ("Hausman: FE vs RE (sigmamo
> re)") ///
>                     (r(chi2)) (r(df)) (r(p))
 70.                 noisily hausman fe_`tag' re_`tag', sigmamore
 71.             }
 72.             else {
 73.                 display as text "Hausman 检验失败（VCE 非正定），报告 chi2
>  与 p 不可用。"
 74.                 post hausman_handle ("`tag'") ("Hausman: FE vs RE (spatial
> )") (.) (.) (.)
 75.             }
 76.         }
 77.     }
 78.     else {
 79.         display as text "RE 模型估计不收敛，跳过空间 Hausman 检验。"
 80.         post hausman_handle ("`tag'") ("Hausman: FE vs RE (spatial)") (.) 
> (.) (.)
 81.     }
 82. 
.     log close sdm_`tag'
 83. end

. 
